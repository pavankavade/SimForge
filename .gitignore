# Dependencies
node_modules/

# Production builds and bundles
dist/
build/
.remotion/

# Environment variables
.env
.env.local
.env.*.local

# Operating System files
.DS_Store
Thumbs.db

# Remotion renders and output media
out/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# TypeScript build info
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Any env file (keys), except a template
.env*
!.env.example

# Claude Code per-machine settings
.claude/settings.local.json

# Local scratch, agent session dumps and helper scripts (private, never pushed)
scratch*
opencode_session*.json
oc_help.*

# Large videos under public/ (render-sized; media/demo.mp4 stays tracked)
public/**/*.mp4
