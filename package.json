{
  "name": "simforge",
  "version": "1.0.0",
  "description": "SimForge: Reusable Remotion + React Three Fiber framework for procedural 3D simulations & vertical video generation",
  "repository": {},
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@react-three/fiber": "9.2.0",
    "@remotion/cli": "4.0.537",
    "@remotion/media": "4.0.537",
    "@remotion/three": "4.0.537",
    "@remotion/zod-types": "4.0.537",
    "mediabunny": "1.61.6",
    "postprocessing": "^6.39.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.537",
    "three": "0.178.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.537",
    "@types/react": "19.2.7",
    "@types/three": "0.170.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "new:episode": "node scripts/new-episode.mjs",
    "cues:estimate": "node scripts/estimate-cues.mjs",
    "review": "node scripts/review.mjs",
    "review:all": "node scripts/review-all.mjs",
    "audit": "node scripts/review.mjs --audit",
    "lab": "node scripts/review.mjs CharacterLab --pages",
    "check:video": "node scripts/check-video.mjs",
    "render:siege": "node scripts/solo.mjs render SiegeTowerVideo out/siege-tower.mp4 --concurrency=8 --crf=17 --audio-bitrate=192k",
    "render:starter": "node scripts/solo.mjs render StarterTopic out/starter.mp4 --concurrency=8 --crf=20",
    "render:dungeon": "node scripts/render.mjs DungeonTrap dungeon-trap",
    "still:dungeon": "node scripts/solo.mjs still DungeonTrap out/dungeon-still.png --frame=500",
    "render:boulder": "node scripts/render.mjs RollingBoulder rolling-boulder",
    "still:boulder": "node scripts/solo.mjs still RollingBoulder out/boulder-still.png --frame=840",
    "render:crushing-walls": "node scripts/render-safe.mjs CrushingWalls crushing-walls",
    "render:safe": "node scripts/render-safe.mjs",
    "still:crushing-walls": "node scripts/solo.mjs still CrushingWalls out/crushing-walls-still.png --frame=280",
    "render:cave-home": "node scripts/render.mjs CaveHome cave-home",
    "still:cave-home": "node scripts/solo.mjs still CaveHome out/cave-home-still.png --frame=300",
    "render:slow-flight-short": "node scripts/render.mjs SlowFlightShort slow-flight-short --concurrency 6",
    "render:teleport": "node scripts/render.mjs Teleport teleport --concurrency 6",
    "render:slow-flight": "node scripts/render.mjs SlowFlight slow-flight --concurrency 6",
    "render:nuclear-bunker": "node scripts/render.mjs NuclearBunker nuclear-bunker --concurrency 6",
    "thumb:dart-trap": "node scripts/render-dart-thumbnails.mjs",
    "thumb:dungeon-campaign": "node scripts/render-campaign-thumbnails.mjs",
    "thumb:lava-bridge": "node scripts/render-lava-thumbnails.mjs",
    "thumb:dungeon-trap-v2": "node scripts/render-dungeon-trap-v2-thumbnails.mjs",
    "thumb:castle-wall": "remotion still CastleWallThumbnail out/thumbnails/castle-wall-thumb.png --frame=2108",
    "thumb:lighthouse": "node scripts/solo.mjs still LighthouseThumbnail out/thumbnails/lighthouse-thumb.png --frame=2500",
    "thumb:nuclear-bunker": "node scripts/solo.mjs still NuclearBunkerThumbnail out/thumbnails/nuclear-bunker-thumb.png --frame=3398",
    "still:nuclear-bunker": "node scripts/solo.mjs still NuclearBunker out/nuclear-bunker-still.png --frame=1250",
    "render:lighthouse": "node scripts/render.mjs Lighthouse lighthouse --concurrency 6",
    "still:lighthouse": "node scripts/solo.mjs still Lighthouse out/lighthouse-still.png --frame=1600",
    "render:castle-wall": "node scripts/render.mjs CastleWall castle-wall --concurrency 6",
    "still:castle-wall": "node scripts/solo.mjs still CastleWall out/castle-wall-still.png --frame=1300",
    "render:dart-trap": "node scripts/render.mjs DartTrap dart-trap",
    "still:dart-trap": "node scripts/solo.mjs still DartTrap out/dart-trap-still.png --frame=280",
    "render:dungeon-campaign": "node scripts/render.mjs DungeonCampaign dungeon-campaign --concurrency 6",
    "still:dungeon-campaign": "node scripts/solo.mjs still DungeonCampaign out/dungeon-campaign-still.png --frame=3000",
    "render:lava-bridge": "node scripts/render.mjs LavaBridge lava-bridge",
    "still:lava-bridge": "node scripts/solo.mjs still LavaBridge out/lava-bridge-still.png --frame=280",
    "render:mimic-vault": "node scripts/render.mjs MimicVault mimic-vault",
    "still:mimic-vault": "node scripts/solo.mjs still MimicVault out/mimic-vault-still.png --frame=280",
    "render:dungeon-trap-v2": "node scripts/render.mjs DungeonTrapV2 dungeon-trap-v2",
    "still:dungeon-trap-v2": "node scripts/solo.mjs still DungeonTrapV2 out/dungeon-trap-v2-still.png --frame=280"
  },
  "allowScripts": {
    "esbuild": false
  }
}
