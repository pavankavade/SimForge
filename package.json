{
  "name": "three-video-framework",
  "version": "1.0.0",
  "description": "Reusable Remotion + React Three Fiber framework for episodic 3D topic videos",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@react-three/fiber": "9.2.0",
    "@remotion/cli": "4.0.537",
    "@remotion/media": "4.0.537",
    "@remotion/three": "4.0.537",
    "@remotion/zod-types": "4.0.537",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.537",
    "three": "0.178.0",
    "zod": "4.5.4",
    "mediabunny": "1.61.6"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.537",
    "@types/react": "19.2.7",
    "@types/three": "0.170.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "new:episode": "node scripts/new-episode.mjs",
    "render:siege": "remotion render SiegeTowerVideo out/siege-tower.mp4 --concurrency=8 --crf=17 --audio-bitrate=192k",
    "render:starter": "remotion render StarterTopic out/starter.mp4 --concurrency=8 --crf=20",
    "render:dungeon": "remotion render DungeonTrap out/dungeon-trap.mp4 --concurrency=8 --crf=18",
    "still:dungeon": "remotion still DungeonTrap out/dungeon-still.png --frame=500"
  },
  "allowScripts": {
    "esbuild": false
  }
}